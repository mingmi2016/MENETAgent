# Optional Ollama or compatible endpoint used for intent parsing and explanations.
# Providers: ollama, compatible_auto, anthropic_compatible, openai_compatible.
MENET_LLM_PROVIDER=ollama
MENET_LLM_BASE_URL=
MENET_LLM_API_KEY=
MENET_LLM_MODEL=
MENET_LLM_INTENT_MODEL=
MENET_LLM_ANALYSIS_MODEL=

# Service settings.
MENET_AGENT_DB=runs/agent.db
MENET_CORE_ROOT=../MENET
MENET_AGENT_WORKERS=1
MENET_AGENT_HOST=127.0.0.1
MENET_AGENT_PORT=8010

# Optional production queue.
MENET_QUEUE_BACKEND=thread
# LSF backend options (used only when MENET_QUEUE_BACKEND=lsf).
MENET_LSF_QUEUE=gpu
MENET_LSF_HOST=gpu01
MENET_LSF_WALLTIME=24:00
# On the server use the GPU Conda environment for submitted jobs.
MENET_PYTHON=/data/user_home/xtcgroup/huawei/envs/menet-web/bin/python
MENET_LSF_PYTHON=/data/user_home/xtcgroup/huawei/envs/torch_gpu/bin/python
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
