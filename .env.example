# Optional OpenAI-compatible endpoint used for intent parsing and explanations.
MENET_LLM_BASE_URL=
MENET_LLM_API_KEY=
MENET_LLM_MODEL=

# Service settings.
MENET_AGENT_DB=runs/agent.db
MENET_AGENT_WORKERS=1
